# 复制到 Streamlit Community Cloud 的 Settings → Secrets。
# 不要把真实 secrets.toml 提交到 Git。

DEEPSEEK_API_KEY = "替换为云端密钥"
DEEPSEEK_MODEL = "deepseek-flash"
APP_ENV = "production"

# 免费公开演示建议维持较低额度。
AI_CALLS_PER_USER_HOUR = "6"
AI_CALLS_PER_USER_DAY = "20"
AI_CALLS_GLOBAL_DAY = "100"

# 如需应用内 OIDC 登录，设为 true，并配置下面的 auth 段。
REQUIRE_LOGIN = "false"
ALLOWED_EMAILS = ""

# [auth]
# redirect_uri = "https://你的应用.streamlit.app/oauth2callback"
# cookie_secret = "使用密码生成器生成的长随机字符串"
# client_id = "OIDC 客户端 ID"
# client_secret = "OIDC 客户端密钥"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
